.invoice-search {
  width: min(520px, 100%);
}
 
.invoice-search .input-group-text:first-child {
  border-top-left-radius: var(--ui-radius-sm);
  border-bottom-left-radius: var(--ui-radius-sm);
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-right: 1px solid #ced4da;
  background: #fff;
}

.invoice-search .form-control {
  border-radius: 0;
  border-right: 0;
  border-left: 0;
}

.invoice-search .btn:last-child {
  border-radius: 0 var(--ui-radius-sm) var(--ui-radius-sm) 0;
  border-left: 0;
}

.invoice-grid {
  margin-top: 8px;
}

.invoice-card-link {
  display: block;
  color: inherit;
  text-decoration: none;
}

.invoice-card .card-body {
  padding: 18px;
}

.invoice-doc {
  font-weight: 600;
  font-size: 1.1rem;
}

.invoice-name {
  margin: 6px 0 8px;
  font-weight: 700;
}

.invoice-line {
  margin-bottom: 6px;
  color: var(--ui-muted);
  font-size: 0.95rem;
}

.invoice-line b {
  color: var(--ui-text);
}

.invoice-error {
  margin-top: 8px;
  font-size: 0.9rem;
}

.invoice-id {
  margin-top: 10px;
}

.invoice-client-group .form-control {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

.invoice-client-group .btn {
  border-radius: 0;
  width: 44px;
  padding: 0;
}

.invoice-client-group .btn:last-child {
  border-top-right-radius: var(--ui-radius-sm);
  border-bottom-right-radius: var(--ui-radius-sm);
}

.invoice-detail-header {
  margin-bottom: 10px;
  --bs-gutter-x: 0;
  margin-left: 0;
  margin-right: 0;
}

.invoice-detail-header .form-group {
  white-space: nowrap;
  font-size: 0.95rem;
}

.invoice-detail-table {
  margin-top: 6px;
  padding-top: 6px;
  --bs-gutter-x: 0;
  margin-left: 0;
  margin-right: 0;
  padding-left: 0;
  padding-right: 0;
}

.invoice-totals {
  margin-top: 12px;
}

.invoice-total-field .input-group-text {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  min-width: 92px;
  justify-content: center;
}

.invoice-total-field .currency {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  display: flex;
  align-items: center;
  border-left: 0;
}

.invoice-actions {
  margin-top: 14px;
}

.invoice-actions {
  flex-wrap: nowrap;
  align-items: center;
  overflow-x: auto;
}

.invoice-actions .form-group {
  flex: 0 0 auto;
  max-width: none;
  width: auto;
}

.invoice-actions .btn,
.invoice-actions .form-control,
.invoice-actions .input-group {
  width: auto;
}

.invoice-actions .btn,
.invoice-actions .form-control,
.invoice-actions .input-group-text {
  height: 44px;
}

.indicator-actions .icon-dropdown {
  width: 34px;
  height: 34px;
  border-radius: 12px;
  text-align: center;
  padding: 0;
}

.indicator-menu {
  position: absolute;
  top: calc(100% + 4px);
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  min-width: 160px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.15);
}

.indicator-menu .dropdown-item {
  font-size: 0.85rem;
}

.indicator-actions .icon-dropdown {
  width: 34px;
  height: 34px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.invoice-action-group .form-control {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

.invoice-action-group .btn {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  border-left: 0;
}

@media (max-width: 575.98px) {
  .invoice-form-card {
    padding: 14px;
  }

  .invoice-form-header {
    gap: 8px;
  }

  .invoice-top-row .col-6,
  .invoice-top-row .col-12 {
    flex: 0 0 100%;
    max-width: 100%;
  }

  .invoice-top-row .input-group,
  .invoice-top-row .form-control,
  .invoice-top-row .form-select {
    width: 100%;
  }

  .invoice-top-row .input-group {
    flex-wrap: nowrap;
    align-items: stretch;
  }

  .invoice-top-row .input-group-text,
  .invoice-top-row .btn {
    flex: 0 0 44px;
    padding: 0;
  }

  .invoice-top-row .form-control {
    min-width: 0;
  }

  .invoice-product-bar {
    padding: 10px;
  }

  .invoice-totals .form-group {
    flex: 0 0 100%;
    max-width: 100%;
  }

  .invoice-action-group {
    flex-wrap: nowrap;
  }
}

.invoice-actions {
  flex-wrap: nowrap;
}

.invoice-actions .form-group {
  flex: 0 0 auto;
  max-width: none;
  width: auto;
}

.invoice-actions .btn,
.invoice-actions .form-control,
.invoice-actions .input-group {
  width: auto;
}

.invoice-form-header {
  margin-bottom: 4px;
}

.invoice-form-header .invoice-top-row {
  margin: 0;
}

.invoice-form-header .col {
  padding-left: 0;
}

.invoice-top-row .input-group-text,
.invoice-top-row .form-control,
.invoice-top-row .btn {
  border-radius: 0;
}

.invoice-top-row .input-group .form-control:first-child,
.invoice-top-row .input-group .input-group-text:first-child {
  border-top-left-radius: var(--ui-radius-sm);
  border-bottom-left-radius: var(--ui-radius-sm);
}

.invoice-top-row .input-group .form-control:last-child,
.invoice-top-row .input-group .btn:last-child {
  border-top-right-radius: var(--ui-radius-sm);
  border-bottom-right-radius: var(--ui-radius-sm);
}

.invoice-top-row .input-group-text {
  border-right: 0;
  background: #f3f4f6;
}

.invoice-top-row .input-group .form-control + .input-group-text,
.invoice-top-row .input-group .form-control + .btn,
.invoice-top-row .input-group-text + .form-control {
  border-left: 0;
}

.invoice-type-group .btn {
  border-left: 0;
}

.invoice-type-group .form-control {
  flex: 1 1 auto;
}

.invoice-type-group {
  max-width: 220px;
}

@media (min-width: 1200px) {
  .invoice-type-group {
    flex: 0 0 200px;
    max-width: 200px;
  }
}

.invoice-detail-header .row.g-3 {
  margin-bottom: 8px;
}

.invoice-detail-table .row.g-3 {
  margin-top: 0;
}

.invoice-product-bar {
  --bs-gutter-x: 12px;
  margin: 8px 0 0;
  padding: 8px 12px 12px;
  background: #143a68;
  border-radius: var(--ui-radius-md);
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  box-sizing: border-box;
}

.invoice-product-bar label {
  display: block;
  margin: 0 0 6px;
  line-height: 1.3;
  color: #e6f2ff;
}

.invoice-product-bar .form-group {
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 0;
  padding-bottom: 0;
}

.invoice-consecutive-group .input-group-text {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-right: 0;
}

.invoice-consecutive-group .form-control {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}

.invoice-form-card .btn.btn-info {
  height: 44px;
  min-width: 44px;
  padding: 0 12px;
  background: #143a68 !important;
  border-color: #143a68 !important;
  color: #fff !important;
}

.invoice-form-card .btn.btn-info:hover,
.invoice-form-card .btn.btn-info:focus {
  background: #102f55 !important;
  border-color: #102f55 !important;
  color: #fff !important;
}

.invoice-product-bar .form-control,
.invoice-product-bar .input-group-text,
.invoice-product-bar .btn {
  border-radius: var(--ui-radius-sm);
}

.invoice-product-bar .input-group .form-control {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

.invoice-product-bar .input-group .btn {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  border-left: 0;
}


.invoice-form {
  margin-top: 12px;
}

.invoice-form-card {
  background: var(--ui-surface);
  border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius-lg);
  padding: 18px;
  box-shadow: var(--ui-shadow-sm);
}

.invoice-form-card label {
  font-weight: 600;
  color: var(--ui-text);
}

.invoice-form-card .input-group-text {
  background: #f3f4f6;
}

.invoice-form-card textarea.form-control {
  min-height: 96px;
}
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
  padding: 1rem;
  overflow-y: auto;
}

.modal-panel.catalog-panel {
  background: #fff;
  border-radius: 14px;
  width: min(1100px, 100%);
  max-height: 90vh;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  padding: 0.25rem 0.5rem;
  border-bottom: 1px solid #e9ecef;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
}

.modal-title {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 600;
}

.modal-subtitle {
  margin: 0.25rem 0 0;
  color: #6c757d;
  font-size: 0.9rem;
}

.page-form {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
}

.modal-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  overflow-y: auto;
  flex: 1;
  min-height: 0;
  max-height: calc(90vh - 220px);
}

.metadata-grid,
.format-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.field-group label {
  font-weight: 600;
  font-size: 0.85rem;
  color: #495057;
}

.field-group input,
.field-group select {
  border-radius: 8px;
  border: 1px solid #ced4da;
  padding: 0.45rem 0.65rem;
  font-family: inherit;
  font-size: 0.95rem;
}

.section-tabs {
  display: flex;
  gap: 0.25rem;
  min-height: 20p;
  border-bottom: 1px solid #e9ecef;
  padding-bottom: 0.3rem;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 5;
}

.catalog-view-tabs {
  padding: 0.5rem;
}

.catalog-view-tabs .btn {
  border-radius: 999px;
  font-weight: 600;
  background: #fff;
  border: 1px solid #ced4da;
  color: #0d6efd;
  transition: background 0.2s, box-shadow 0.2s, color 0.2s;
}

.catalog-view-tabs .btn.active {
  background: #0d6efd;
  color: #fff;
  border-color: #0d6efd;
  box-shadow: 0 10px 20px rgba(13, 110, 253, 0.25);
}

.catalog-tab-content {
  border-top: 1px solid #e9ecef;
  padding-top: 1rem;
}

.tab-header {
  border-radius: 8px 8px 0 0;
  gap: 1rem;
}

.tab-header select {
  border-radius: 6px;
}

.section-tabs button {
  border: none;
  background: transparent;
  padding: 0.25rem 0.75rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: #6c757d;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: color 0.2s, border-color 0.2s;
  white-space: nowrap;
}

.section-tabs button.active {
  color: #0d6efd;
  border-bottom-color: #0d6efd;
}

.tags-table {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.empty-section {
  padding: 0.75rem 0;
  color: #6c757d;
  text-align: center;
}

.tag-row {
  border: 1px solid #dfe3e8;
  border-radius: 10px;
  padding: 1rem 1.25rem;
  background: #fff;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.tag-line {
  display: grid;
  grid-template-columns: minmax(60px, 90px) 210px minmax(280px, 1fr) auto;
  align-items: center;
  gap: 0.9rem;
}

.tag-number {
  font-weight: 700;
  font-size: 1.2rem;
  padding: 0.4rem 0.9rem;
  border-radius: 999px;
  background: #f1f4f7;
  border: 1px solid #d0d5dd;
  text-align: center;
}

.tag-main-info {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.tag-name {
  font-size: 1.05rem;
  font-weight: 600;
}

.tag-sub {
  font-size: 0.8rem;
  color: #6c757d;
}

.tag-value-field input {
  width: 100%;
  border-radius: 8px;
  border: 1px solid #ced4da;
  padding: 0.45rem 0.7rem;
  font-family: inherit;
  font-size: 0.95rem;
  background: #f8f9fb;
}

.tag-indicators {
  display: flex;
  gap: 0.5rem;
}

.tag-indicators select {
  min-width: 90px;
  border-radius: 6px;
  border: 1px solid #ced4da;
  padding: 0.35rem 0.5rem;
  background: white;
}

.subcampos-list {
  border: 1px dashed #dfe3e8;
  border-radius: 8px;
  padding: 0.75rem;
  background: #fafbfc;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.subcampo-row {
  display: grid;
  grid-template-columns: 60px 1fr 1fr;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.subcampo-row:last-child {
  border-bottom: none;
}

.subcampo-code {
  font-family: monospace;
  font-weight: 600;
  font-size: 0.9rem;
}

.subcampo-name {
  font-weight: 600;
  color: #495057;
}

.subcampo-row input {
  width: 100%;
  border-radius: 6px;
  border: 1px solid #ced4da;
  padding: 0.35rem 0.5rem;
  font-family: inherit;
}

.modal-actions {
  padding: 1rem 1.5rem;
  border-top: 1px solid #e9ecef;
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  background: #fff;
}

.modal-actions .btn-link {
  font-weight: 600;
  color: #6c757d;
}
.tags-table .table {
  width: 100%;
  table-layout: fixed;
}

.tags-table .col-name,
.tags-table .tag-name-cell {
  width: 14%;
}

.tags-table .col-valor,
.tags-table .tag-value-cell {
  width: 34%;
}

.tags-table .tag-name-cell .fw-semibold {
  font-size: 0.95rem;
}

.indicator-chip {
  display: inline-flex;
  gap: 0.4rem;
  padding: 0.1rem 0.55rem;
  margin-left: 0.45rem;
  border-radius: 12px;
  background: rgba(13, 110, 253, 0.1);
  color: #0d6efd;
  font-size: 0.75rem;
}
