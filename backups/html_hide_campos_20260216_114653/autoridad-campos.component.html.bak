<div class="container-fluid pb-5">
  <section class="catalog-section">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 tags-header">
      <div>
        <h3 class="h5 mb-1">Autoridades</h3>
        <small class="text-muted d-block">Asocia los tags del diccionario MARC con una autoridad y define sus indicadores y subcampos.</small>
        <div class="small text-muted mt-1">
          {{ getSelectedAutoridadLabel() }}
        </div>
      </div>
      <div class="d-flex gap-2 flex-wrap align-items-center">
        <select
          class="form-select"
          [(ngModel)]="selectedAutoridadId"
          (change)="onAutoridadChange(selectedAutoridadId)">
          <option [ngValue]="undefined">Seleccione una autoridad...</option>
          <option *ngFor="let autoridad of autoridades" [ngValue]="autoridad.id">{{ autoridad.encabezado }}</option>
        </select>
        <select
          class="form-select"
          [(ngModel)]="selectedFormatoId"
          (change)="onFormatoChange()">
          <option [ngValue]="undefined">Formato MARC...</option>
          <option *ngFor="let formato of formatos" [ngValue]="formato.id">{{ formato.nombre }}</option>
        </select>
        <button class="btn btn-success" type="button" (click)="guardarAsignaciones()" [disabled]="isSaving || !selectedAutoridadId">
          {{ isSaving ? 'Guardando...' : 'Guardar asignaciones' }}
        </button>
      </div>
    </div>

    <div class="d-flex align-items-center justify-content-between tags-header-row mb-3">
      <div class="pagination-controls d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary" type="button" (click)="selectSection(currentPage - 1)" [disabled]="currentPage <= 1">
          <i class="fa fa-chevron-left"></i>
        </button>
        <span class="text-muted small">{{ getSectionLabel(currentPage) }}</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" (click)="selectSection(currentPage + 1)" [disabled]="currentPage >= secciones.length">
          <i class="fa fa-chevron-right"></i>
        </button>
      </div>
      <div class="section-tabs d-flex flex-wrap gap-2">
        <button
          *ngFor="let section of secciones"
          type="button"
          class="btn btn-sm"
          [class.btn-light]="currentPage !== section"
          [class.btn-primary]="currentPage === section"
          (click)="selectSection(section)">
          {{ getSectionLabel(section) }}
        </button>
      </div>
    </div>

    <div class="tags-table p-3 border rounded bg-white">
      <div *ngIf="!selectedFormatoId" class="text-muted small text-center py-3">Selecciona un formato MARC para visualizar tags.</div>
      <div *ngIf="selectedFormatoId && getTagsPorSeccion().length === 0" class="text-muted small text-center py-3">No hay tags para esta sección.</div>
      <div *ngIf="selectedFormatoId && getTagsPorSeccion().length > 0" class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
          <thead>
            <tr>
              <th>Tag</th>
              <th class="col-name">Nombre</th>
              <th>Grupo</th>
              <th>Orden</th>
              <th class="col-valor">Valor</th>
              <th class="text-center">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <ng-container *ngFor="let campo of getTagsPorSeccion()">
              <ng-container *ngIf="getEntry(campo.tag, campo.nombre) as entry">
                <tr>
                  <td>{{ campo.tag }}</td>
                  <td class="tag-name-cell">
                    <div class="fw-semibold">{{ campo.nombre }}</div>
                    <div class="text-muted small">
                      {{ campo.formatoNombre || '' }}
                      <span *ngIf="entry.ind1 || entry.ind2" class="indicator-chip">
                        <span *ngIf="entry.ind1">I1: {{ getIndicatorLabel(campo.tag, 1, entry.ind1) }}</span>
                        <span *ngIf="entry.ind2" class="ms-2">I2: {{ getIndicatorLabel(campo.tag, 2, entry.ind2) }}</span>
                      </span>
                    </div>
                  </td>
                  <td>{{ campo.grupo || 'Sin grupo' }}</td>
                  <td>{{ campo.orden ?? 'N/A' }}</td>
                  <td class="tag-value-cell">
                    <input
                      class="form-control form-control-sm"
                      type="text"
                      [(ngModel)]="entry.valor"
                      [name]="'valor-' + campo.tag"
                      placeholder="{{ campo.nombre }}" />
                  </td>
                  <td class="text-center">
                    <div class="indicator-actions d-flex justify-content-center align-items-center gap-2">
                      <div *ngIf="getIndicatorOptions(campo.tag, 1).length > 0" class="position-relative">
                        <button class="btn btn-outline-secondary btn-sm icon-dropdown"
                          type="button"
                          (click)="toggleIndicatorDropdown(entry, 1, $event)"
                          [attr.title]="'Indicador 1: ' + (entry.ind1 || '(vacío)')">
                          <i class="fa fa-info-circle"></i>
                        </button>
                        <div *ngIf="isIndicatorDropdownOpen(entry, 1)" class="indicator-menu">
                          <button class="dropdown-item" type="button" (click)="setIndicator(entry, 1, ''); closeIndicatorDropdown(entry)">
                            (vacío)
                          </button>
                          <button *ngFor="let opt of getIndicatorOptions(campo.tag, 1)" class="dropdown-item" type="button"
                            (click)="setIndicator(entry, 1, opt.value); closeIndicatorDropdown(entry)">
                            {{ opt.value }}{{ opt.meaning ? ' · ' + opt.meaning : '' }}
                          </button>
                        </div>
                      </div>
                      <div *ngIf="getIndicatorOptions(campo.tag, 2).length > 0" class="position-relative">
                        <button class="btn btn-outline-secondary btn-sm icon-dropdown"
                          type="button"
                          (click)="toggleIndicatorDropdown(entry, 2, $event)"
                          [attr.title]="'Indicador 2: ' + (entry.ind2 || '(vacío)')">
                          <i class="fa fa-info-circle"></i>
                        </button>
                        <div *ngIf="isIndicatorDropdownOpen(entry, 2)" class="indicator-menu">
                          <button class="dropdown-item" type="button" (click)="setIndicator(entry, 2, ''); closeIndicatorDropdown(entry)">
                            (vacío)
                          </button>
                          <button *ngFor="let opt of getIndicatorOptions(campo.tag, 2)" class="dropdown-item" type="button"
                            (click)="setIndicator(entry, 2, opt.value); closeIndicatorDropdown(entry)">
                            {{ opt.value }}{{ opt.meaning ? ' · ' + opt.meaning : '' }}
                          </button>
                        </div>
                      </div>
                      <button
                        *ngIf="hasSubcampos(campo.tag)"
                        class="btn btn-outline-secondary btn-sm icon-dropdown"
                        type="button"
                        (click)="openSubcampoModal(entry)"
                        title="Subcampos">
                        <i class="fa fa-list"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              </ng-container>
            </ng-container>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <div class="modal-mask" *ngIf="subcampoModalVisible">
    <div class="modal-panel catalog-panel">
      <div class="modal-header">
        <div>
          <h5 class="modal-title">Subcampos</h5>
          <p class="modal-subtitle mb-0">{{ activeSubcamposEntry?.tag }}</p>
        </div>
        <button type="button" class="btn-close" aria-label="Cerrar" (click)="closeSubcampoModal()"></button>
      </div>
      <div class="modal-body">
        <div class="table-responsive">
          <table class="table table-sm table-borderless mb-0">
            <thead>
              <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th class="col-valor">Valor</th>
              </tr>
            </thead>
            <tbody>
              <tr *ngFor="let sub of activeSubcamposEntry?.subcampos">
                <td>{{ sub.codigo }}</td>
                <td>{{ sub.nombre }}</td>
                <td>
                  <input class="form-control form-control-sm" type="text" [(ngModel)]="sub.valor"
                    [name]="'modal-sub-' + activeSubcamposEntry?.tag + '-' + sub.codigo" />
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-actions">
        <button class="btn btn-secondary" type="button" (click)="closeSubcampoModal()">Cerrar</button>
      </div>
    </div>
  </div>
</div>
